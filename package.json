{
  "name": "tw1tch-prism-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts && esbuild apps/server/src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@prism/shared=./packages/shared/src/index.ts --alias:@prism/physics=./packages/physics/src/index.ts --outfile=dist/server/index.js",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "harness": "npm run secrets:check && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e",
    "gaze:assets": "node scripts/gaze-assets.mjs",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@mediapipe/tasks-vision": "1.1.1",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
