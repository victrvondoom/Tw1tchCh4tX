# Copy to .env. Demo works with no Twitch credentials.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=./data/prism-x.db
# Required for production/non-loopback binding: a private random 32+ character key.
OPERATOR_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional numeric account restriction. Broadcaster signs in to their own channel.
TWITCH_CHANNEL_ID=
TWITCH_REDIRECT_URI=http://localhost:5173/auth/twitch/callback
